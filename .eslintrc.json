{
    "env": {
        "browser": true,
        "es2022": true,
        "jquery": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "globals": {
        "SillyTavern": "readonly",
        "toastr": "readonly",
        "getRegexScripts": "readonly",
        "runRegexScript": "readonly",
        "debounce": "readonly",
        "translate": "readonly",
        "t": "readonly"
    },
    "rules": {
        "no-unused-vars": "warn",
        "no-undef": "error",
        "no-import-assign": "error"
    }
}
